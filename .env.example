# Set these in Vercel project environment variables.
API_FOOTBALL_KEY=
FOOTBALL_DATA_ORG_KEY=
# Optional: conservative API-Football daily budget for this app.
API_FOOTBALL_DAILY_LIMIT=100
# Storage: connect Upstash Redis from Vercel Storage; these are injected automatically.
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work.)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Scheduled prefetch: protects /api/prefetch (use a long random string).
CRON_SECRET=
# Optional: football-data.org competition codes to keep warm (default CL).
PREFETCH_COMPETITIONS=CL
# Optional StrikerAPI enrichment (market consensus, Elo, head-to-head). Free key: strikerapi.com/signup
STRIKERAPI_API_KEY=
# Credit cap per rolling 30 days (free tier is 500).
STRIKERAPI_MONTHLY_CREDITS=450
# Set to off to disable market-based forecasts.
STRIKERAPI_MARKET_FORECASTS=
# Optional accounts: Supabase Auth (GitHub sign-in) plus tables from supabase/schema.sql.
SUPABASE_URL=
# Server-only secret key (sb_secret_...). Never expose it to the browser.
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_...), safe to expose; used for the sign-in code exchange.
SUPABASE_PUBLISHABLE_KEY=
# Optional: address people return to after signing in (defaults to the request origin).
SITE_URL=
# Sign-in buttons to show: github, google or github,google (each must also be enabled in Supabase).
AUTH_PROVIDERS=github
